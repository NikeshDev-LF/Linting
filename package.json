{
  "name": "cypress-demo-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md-names": "node scripts/check-md-filenames.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "npm run lint:md-names && npm run lint && npm run format:check",
    "test:form:chrome": "npx cypress run --browser chrome --spec cypress/e2e/formSubmission.cy.js",
    "test:form:edge": "npx cypress run --headed --browser edge --spec cypress/e2e/formSubmission.cy.js",
    "test:chrome": "npx cypress run --browser chrome",
    "test:edge": "npx cypress run --browser edge",
    "open": "npx cypress open",
    "prepare": "husky"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "cypress": "^14.5.4",
    "dotenv": "^16.4.5",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-validate-filename": "^1.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,md}": [
      "eslint --no-ignore --ext .js,.md --max-warnings=0",
      "prettier --write"
    ]
  }
}
